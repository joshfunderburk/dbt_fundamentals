[sqlfluff]
dialect = snowflake
templater = dbt
exclude_rules = L029,L031,L034
max_line_length = 120

[sqlfluff:templater:dbt]
project_dir = ./
profiles_dir = ~/.dbt
target = dev

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper